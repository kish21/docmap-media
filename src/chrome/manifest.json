{
  "manifest_version": 3,
  "name": "docmap — Markdown Outline & Reader",
  "version": "3.3.2",
  "description": "Read local & GitHub Markdown with an outline, Clean View, Slides, AI review highlights & Mermaid. Free, offline, private.",
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "docmap — Markdown Outline & Reader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*.md",
        "file:///*.markdown",
        "file:///*.MD",
        "file:///*.MARKDOWN",
        "https://raw.githubusercontent.com/*/*.md",
        "https://raw.githubusercontent.com/*/*.markdown",
        "https://gist.githubusercontent.com/*/*.md"
      ],
      "css": ["tokens.css", "styles.css", "chrome-local.css"],
      "js": ["local.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://github.com/*"],
      "css": ["github.css"],
      "js": ["github.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["mermaid.js"],
      "matches": ["file://*/*", "https://raw.githubusercontent.com/*", "https://gist.githubusercontent.com/*"]
    }
  ]
}
